#!/bin/sh
# Обёртка над скриптами получения списков из /opt/zapret2/ipset.
# Нужна затем, что ipset/get_*.sh, запущенные напрямую, считают ZAPRET_RW равным
# ZAPRET_BASE и полезут писать списки в /opt/zapret2/ipset (его затрёт обновление пакета).
#
#   zapret2-list                 # запустить GETLIST из конфига
#   zapret2-list get_user.sh     # запустить конкретный скрипт
#   zapret2-list --list          # показать доступные скрипты
#   zapret2-list --bootstrap     # первичное наполнение списка + включение фильтрации
#   zapret2-list --cron on|off   # автообновление списка через cron

# Пути переопределяются только тестами; в бою дефолтные — как и в S99zapret2.
ZAPRET_BASE=${ZAPRET_BASE:-/opt/zapret2}
ZAPRET_RW=${ZAPRET_RW:-/opt/etc/zapret2}
ZAPRET_CONFIG=${ZAPRET_CONFIG:-$ZAPRET_RW/config}
export ZAPRET_BASE ZAPRET_RW ZAPRET_CONFIG
PATH=/opt/bin:/opt/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Скрипт первичного наполнения по умолчанию. Выбран не случайно: он скачивает
# доменный список ПЕРВЫМ делом, а getipban/create_ipset дёргает уже после.
# У get_refilter_domains.sh и get_antizapret_domains.sh порядок обратный — при
# неудаче ipset-части они выходят, не скачав ничего, а компонент IPset на
# Keenetic не обязателен.
BOOTSTRAP_SCRIPT=${ZAPRET_BOOTSTRAP_SCRIPT:-get_reestr_resolvable_domains.sh}
BOOTSTRAP_MODE=${ZAPRET_BOOTSTRAP_MODE:-autohostlist}

# Автообновление списка. Entware держит расписания в /opt/etc/crontabs/root —
# файл общий, туда пишут и другие пакеты, и сам пользователь. Поэтому свою
# строку помечаем и снимаем точечно, а файл целиком не трогаем.
CRONTAB=${ZAPRET_CRONTAB:-/opt/etc/crontabs/root}
CRON_CMD=${ZAPRET_CRON_CMD:-/opt/bin/zapret2-list}
CRON_MARK='# zapret2-list: автообновление списка'
# Раз в двое суток, ночью. Оговорка про */2: cron считает дни месяца, поэтому
# на стыке месяцев интервал может оказаться суточным. Для обновления списка
# это несущественно.
CRON_SCHEDULE=${ZAPRET_CRON_SCHEDULE:-'17 4 */2 * *'}

# Печатает имена доступных ipset/get_*.sh, по одному в строке.
list_scripts()
{
	for _s in "$ZAPRET_BASE/ipset"/get_*.sh; do
		[ -f "$_s" ] || continue
		echo "${_s##*/}"
	done
}

# Доменный список, который читает nfqws при MODE_FILTER=hostlist/autohostlist.
# def.sh upstream кладёт его сюда; вариант .gz появляется при GZIP_LISTS=1.
hostlist_present()
{
	[ -s "$ZAPRET_RW/ipset/zapret-hosts.txt.gz" ] || [ -s "$ZAPRET_RW/ipset/zapret-hosts.txt" ]
}

config_get() { sed -n "s/^[[:space:]]*$1=//p" "$ZAPRET_CONFIG" 2>/dev/null | head -n1; }

config_set()
{
	# $1 - имя переменной, $2 - значение
	[ -f "$ZAPRET_CONFIG.bak" ] || cp "$ZAPRET_CONFIG" "$ZAPRET_CONFIG.bak"
	if grep -q "^[[:space:]]*$1=" "$ZAPRET_CONFIG"; then
		sed "s|^[[:space:]]*$1=.*|$1=$2|" "$ZAPRET_CONFIG" >"$ZAPRET_CONFIG.new"
	elif grep -q "^#$1=" "$ZAPRET_CONFIG"; then
		sed "s|^#$1=.*|$1=$2|" "$ZAPRET_CONFIG" >"$ZAPRET_CONFIG.new"
	else
		{ cat "$ZAPRET_CONFIG"; printf '\n%s=%s\n' "$1" "$2"; } >"$ZAPRET_CONFIG.new"
	fi
	mv "$ZAPRET_CONFIG.new" "$ZAPRET_CONFIG"
}

run_script()
{
	# $1 - имя скрипта из ipset/
	[ -f "$ZAPRET_BASE/ipset/$1" ] || { echo "нет $ZAPRET_BASE/ipset/$1" >&2; return 1; }
	mkdir -p "$ZAPRET_RW/ipset"
	sh "$ZAPRET_BASE/ipset/$1"
}

# Первичное наполнение: скачать список и только ПОСЛЕ этого включить фильтрацию.
#
# Порядок принципиален. Маркер <HOSTLIST> в NFQWS2_OPT разворачивается в
# --hostlist=<файл> (см. common/list.sh upstream), и если файла нет, под фильтр
# не подпадает ни один домен. Что при этом происходит, зависит от режима:
#   hostlist     - навсегда ничего: обход молча не работает при живом сервисе
#                  и стоящих правилах;
#   autohostlist - сначала тоже ничего, но nfqws доучивается сам по сбоям, то
#                  есть каждый домен начинает работать после первых неудач.
# Оба варианта хуже, чем none, где обрабатывается весь трафик сразу. Поэтому при
# неудачной загрузке режим остаётся none: дороже по CPU, но работает немедленно.
do_bootstrap()
{
	[ -f "$ZAPRET_CONFIG" ] || { echo "нет конфига $ZAPRET_CONFIG" >&2; return 1; }

	_mf=$(config_get MODE_FILTER)
	[ -n "$_mf" ] || _mf=none
	if [ "$_mf" != none ]; then
		echo "MODE_FILTER=$_mf уже настроен — список не трогаю. Обновить: zapret2-list"
		return 0
	fi

	if hostlist_present; then
		echo "список уже на месте, включаю MODE_FILTER=$BOOTSTRAP_MODE"
	else
		echo "качаю список доменов ($BOOTSTRAP_SCRIPT), это займёт время"
		if ! run_script "$BOOTSTRAP_SCRIPT" || ! hostlist_present; then
			echo "zapret2: список скачать не удалось — оставляю MODE_FILTER=none." >&2
			echo "zapret2: это не поломка, обход будет работать по всему трафику на портах" >&2
			echo "zapret2: из конфига, просто дороже по CPU." >&2
			echo "zapret2: повторить позже: zapret2-list --bootstrap" >&2
			return 1
		fi
	fi

	config_set MODE_FILTER "$BOOTSTRAP_MODE"
	config_set GETLIST "$BOOTSTRAP_SCRIPT"
	echo "zapret2: список на месте, включён MODE_FILTER=$BOOTSTRAP_MODE"
	# GETLIST теперь задан, значит `zapret2-list` без аргументов знает, что качать,
	# и расписание имеет смысл. До этого момента включать его было бы нечем.
	cron_on
	return 0
}

# Снимает нашу строку, чужие не трогает. Идемпотентно.
cron_off()
{
	[ -f "$CRONTAB" ] || return 0
	grep -v "$CRON_MARK" "$CRONTAB" >"$CRONTAB.new" 2>/dev/null || true
	mv "$CRONTAB.new" "$CRONTAB"
}

cron_on()
{
	mkdir -p "${CRONTAB%/*}" 2>/dev/null || true
	[ -f "$CRONTAB" ] || : >"$CRONTAB"
	# Сначала снимаем прежнюю: иначе повторный вызов наплодил бы дубли.
	cron_off
	echo "$CRON_SCHEDULE $CRON_CMD >/dev/null 2>&1 $CRON_MARK" >>"$CRONTAB"
	if command -v crond >/dev/null 2>&1 || command -v cron >/dev/null 2>&1; then
		echo "zapret2: автообновление списка включено ($CRON_SCHEDULE)"
	else
		echo "zapret2: строка в $CRONTAB добавлена, но демон cron не найден." >&2
		echo "zapret2: поставь его — opkg install cron — иначе расписание не сработает." >&2
	fi
}

case "$1" in
	--cron)
		case "$2" in
			on)  cron_on ;;
			off) cron_off; echo "zapret2: автообновление списка выключено" ;;
			status|"")
				if [ -f "$CRONTAB" ] && grep -q "$CRON_MARK" "$CRONTAB"; then
					grep "$CRON_MARK" "$CRONTAB"
				else
					echo "автообновление списка выключено"
				fi
				;;
			*) echo "usage: zapret2-list --cron on|off|status" >&2; exit 1 ;;
		esac
		exit 0
		;;
	--list|-l)
		list_scripts
		exit 0
		;;
	--bootstrap)
		[ -z "$2" ] || BOOTSTRAP_SCRIPT=$2
		do_bootstrap
		exit $?
		;;
esac

SCRIPT=$1
if [ -z "$SCRIPT" ]; then
	# shellcheck disable=SC1090
	. "$ZAPRET_CONFIG"
	SCRIPT=$GETLIST
	[ -n "$SCRIPT" ] || {
		echo "GETLIST не задан в $ZAPRET_CONFIG. Доступные скрипты:" >&2
		list_scripts >&2
		exit 1
	}
fi

run_script "$SCRIPT"
